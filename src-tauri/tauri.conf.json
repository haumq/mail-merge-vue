{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mail Merge",
  "version": "1.0.17",
  "identifier": "com.uef.mail-merge-vue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mail Merge",
        "width": 1100,
        "height": 600
      }
    ],
